# Public entry point: HTTPS certificates are obtained and renewed by Caddy.
# SITE_ADDRESS is a domain (ai.example.com) for production, or
# http://localhost to try it locally without TLS (with HTTP_PORT=8080 in
# .env: the address sets the port Caddy listens on inside its container).
{$SITE_ADDRESS} {
	encode zstd gzip
	# Caddy sets X-Forwarded-For to the client's address (it replaces what the
	# client sent) and X-Forwarded-Proto; the app trusts them from Caddy only
	# (TRUST_PROXY = the compose network, see compose.yaml).
	reverse_proxy app:3000
}
