# Copy to .env and adjust. Never commit .env.
PORT=3000
# Path to the SQLite database file.
DB_PATH=./data/dashboard.db
# Where npm run backup and the pre-upgrade backups go (default: backups/
# next to the database). Copy them off this machine too.
# BACKUP_DIR=./data/backups
# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto are trusted
# (addresses or CIDR ranges, comma-separated). Set by compose.yaml in Docker.
# TRUST_PROXY=

# docker compose (Deploy in AGENTS.md):
# Subnet of the ai-activity-proxy network, shared by your Caddy container and
# the app only (trusted as TRUST_PROXY). Change it if the range is taken.
# PROXY_SUBNET=172.29.94.0/24
# BACKUP_EVERY_SEC=86400
