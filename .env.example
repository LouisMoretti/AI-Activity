# Copy to .env and adjust. Never commit .env.
PORT=3000
# Optional one-time migration: with no account yet, boot creates an admin
# account DASHBOARD_USER (default "admin") with this password. Ignored once
# an account exists; prefer `npm run user -- add <username>`.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Path to the SQLite database file.
DB_PATH=./data/dashboard.db
