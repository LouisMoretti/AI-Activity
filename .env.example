# Copy to .env and adjust. Never commit .env.
PORT=3000
# Path to the SQLite database file.
DB_PATH=./data/dashboard.db
# Where npm run backup and the pre-upgrade backups go (default: backups/
# next to the database). Copy them off this machine too.
# BACKUP_DIR=./data/backups
# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto are trusted
# (addresses or CIDR ranges, comma-separated). Set by compose.yaml in Docker.
# TRUST_PROXY=

# Sign in with GitHub (the only way to sign in): a GitHub OAuth app
# (github.com/settings/developers → New OAuth App) whose callback URL is
# <public address>/api/auth/github/callback. Nobody can sign in without it.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# The public address (e.g. https://ai.example.com), for the callback. Unset:
# the address the browser used (the Host header, through Caddy or a tunnel).
# PUBLIC_URL=

# docker compose (Deploy in AGENTS.md):
# Subnet of the ai-activity-proxy network, shared by your Caddy container and
# the app only (trusted as TRUST_PROXY). Change it if the range is taken.
# PROXY_SUBNET=172.29.94.0/24
# BACKUP_EVERY_SEC=86400

# npm run dev:web: extra host names of your own reverse proxy in front of the
# Vite dev server (comma-separated); Vite then listens on every interface.
# DEV_HOSTS=ai-dev.example.com
