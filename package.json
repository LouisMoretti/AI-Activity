{
  "name": "ai-activity-dashboard",
  "version": "0.1.0",
  "description": "Personal multi-user dashboard for real AI tool usage data (Claude Code first). Demo values are never presented as real measurements.",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.ts",
    "dev": "node --env-file-if-exists=.env --watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "gen-key": "node --env-file-if-exists=.env scripts/gen-key.ts",
    "user": "node --env-file-if-exists=.env scripts/user.ts",
    "typecheck": "tsc -p tsconfig.json && svelte-check --tsconfig web/tsconfig.json --fail-on-warnings",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^11.10.0",
    "hono": "^4.13.9"
  },
  "engines": {
    "node": ">=22.18"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
