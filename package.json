{
  "name": "ai-activity",
  "version": "0.1.0",
  "description": "Personal multi-user dashboard for real AI tool usage data (Claude Code first). Demo values are never presented as real measurements.",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.ts",
    "dev": "node --import ./scripts/dev-env.ts --watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts",
    "restore": "node --env-file-if-exists=.env scripts/restore.ts",
    "typecheck": "node node_modules/typescript-7/bin/tsc -p tsconfig.json && svelte-check --tsconfig web/tsconfig.json --fail-on-warnings",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test --test-concurrency=1 test/browser/*.test.js"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.12"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.16"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "fsevents": false
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "^8.3.1"
  }
}
