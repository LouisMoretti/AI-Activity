# Install scripts run only for dependencies reviewed in package.json's
# `allowScripts` (npm >= 11.16): any other one fails the install instead of
# running, or of being skipped silently. Review it, then list it there:
# `true` to run it, `false` to skip it.
# Denied: better-sqlite3 and fsevents ship their binaries in the package;
# npm still runs `node-gyp rebuild` for better-sqlite3 from the lockfile
# (npm/cli#9837), which fails without a C toolchain (the image).
strict-allow-scripts=true
